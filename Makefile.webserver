# Felix Webserver — standalone build
# Builds ONLY flt_webserver (not the full felixterminal app). Reuses the same
# flags/dependency-detection conventions as the felixterminal Makefile.

CXX := g++
CC  := gcc
PKG_CONFIG := pkg-config

CXX_WIN := x86_64-w64-mingw32-g++
CC_WIN  := x86_64-w64-mingw32-gcc
PKG_CONFIG_WIN := mingw64-pkg-config

CXXFLAGS_COMMON := -Wall -Wextra -std=c++17 -O2 -ffunction-sections -fdata-sections -flto \
                    -DDONTUSEGMP -DLINUX -DUSESSH -Dwebserver
CFLAGS_COMMON   := -Wall -Wextra -O2

SDL2_CFLAGS   := $(shell $(PKG_CONFIG) --cflags sdl2 2>/dev/null || echo "")
SDL2_LIBS     := $(shell $(PKG_CONFIG) --libs   sdl2 2>/dev/null || echo "-lSDL2")

SSH2_CFLAGS   := $(shell $(PKG_CONFIG) --cflags libssh2 2>/dev/null || echo "")
SSH2_LIBS     := $(shell $(PKG_CONFIG) --libs   libssh2 2>/dev/null || echo "-lssh2")

FFMPEG_CFLAGS := $(shell $(PKG_CONFIG) --cflags libavformat libavcodec libavutil libswresample 2>/dev/null || echo "")
FFMPEG_LIBS   := $(shell $(PKG_CONFIG) --libs   libavformat libavcodec libavutil libswresample 2>/dev/null || echo "-lavformat -lavcodec -lavutil -lswresample")

# ============================================================================
# WINDOWS (mingw) equivalents
# No ffmpeg on Windows — M4A/WMA conversion uses Media Foundation instead
# (convertm4atowavwin.cpp), matching the felixterminal Makefile's Windows build.
# ============================================================================
SDL2_CFLAGS_WIN := $(shell $(PKG_CONFIG_WIN) --cflags sdl2 2>/dev/null || echo "")
SDL2_LIBS_WIN   := $(shell $(PKG_CONFIG_WIN) --libs   sdl2 2>/dev/null || echo "-lSDL2")

SSH2_CFLAGS_WIN := $(shell $(PKG_CONFIG_WIN) --cflags libssh2 2>/dev/null || echo "")
SSH2_LIBS_WIN   := $(shell $(PKG_CONFIG_WIN) --libs   libssh2 2>/dev/null || echo "-lssh2")

.DEFAULT_GOAL := all

CXXFLAGS := $(CXXFLAGS_COMMON) $(SDL2_CFLAGS) $(SSH2_CFLAGS) $(FFMPEG_CFLAGS)
LDFLAGS  := $(SDL2_LIBS) $(SSH2_LIBS) $(FFMPEG_LIBS) -lssl -lcrypto -lpng -lz -lm -pthread -lstdc++ \
            -s -Wl,--gc-sections -flto

# ============================================================================
# DEBUG FLAGS  (ASan + UBSan, matching the felixterminal Makefile's `debug` build)
# -O0 -g keeps symbols/line info intact; -fno-omit-frame-pointer + -rdynamic
# keep stack traces readable; sanitizers abort on first error (no -recover).
# ============================================================================
CXXFLAGS_DEBUG := -Wall -Wextra -std=c++17 -DDONTUSEGMP -DLINUX -DUSESSH -Dwebserver -DDEBUG \
                   $(SDL2_CFLAGS) $(SSH2_CFLAGS) $(FFMPEG_CFLAGS) \
                   -g -O0 -fno-omit-frame-pointer \
                   -fsanitize=address -fsanitize=undefined -fno-sanitize-recover=address,undefined

CFLAGS_DEBUG   := -Wall -Wextra -DDEBUG -g -O0 -fno-omit-frame-pointer \
                   -fsanitize=address -fsanitize=undefined -fno-sanitize-recover=address,undefined

LDFLAGS_DEBUG  := $(SDL2_LIBS) $(SSH2_LIBS) $(FFMPEG_LIBS) -lssl -lcrypto -lpng -lz -lm -pthread -lstdc++ \
                   -fsanitize=address -fsanitize=undefined -rdynamic

# ============================================================================
# WINDOWS FLAGS  (cross-compiled with mingw-w64)
# Media Foundation (mf, mfplat, mfreadwrite, mfuuid) replaces ffmpeg for M4A;
# shlwapi/ws2_32/ole32/oleaut32 needed by ssh_session.cpp + MF glue.
# ============================================================================
CXXFLAGS_WIN := -Wall -Wextra -std=c++17 -O2 -ffunction-sections -fdata-sections -flto \
                -DDONTUSEGMP -DWIN32 -D_WIN32 -D_WIN32_WINNT=0x0A00 -DUSESSH -Dwebserver \
                $(SDL2_CFLAGS_WIN) $(SSH2_CFLAGS_WIN)

LDFLAGS_WIN  := $(SDL2_LIBS_WIN) $(SSH2_LIBS_WIN) -lcrypto -lssl -lpng -lz -lshlwapi -lws2_32 \
                -lmf -lmfplat -lmfreadwrite -lmfuuid -lole32 -loleaut32 \
                -s -Wl,--gc-sections -flto

CXXFLAGS_WIN_DEBUG := -Wall -Wextra -std=c++17 -DDONTUSEGMP -DWIN32 -D_WIN32 -D_WIN32_WINNT=0x0A00 \
                       -DUSESSH -Dwebserver -DDEBUG \
                       $(SDL2_CFLAGS_WIN) $(SSH2_CFLAGS_WIN) \
                       -g -O0

LDFLAGS_WIN_DEBUG := $(SDL2_LIBS_WIN) $(SSH2_LIBS_WIN) -lcrypto -lssl -lpng -lz -lshlwapi -lws2_32 \
                      -lmf -lmfplat -lmfreadwrite -lmfuuid -lole32 -loleaut32

# ============================================================================
# SOURCES
# felixwebserver.cpp + sftp_webserver.cpp, plus everything they actually pull
# in: terminal.cpp (term_feed / g_term_write_override, needed by
# ssh_session.cpp), the audio-render/convert helpers sftp_webserver.cpp calls
# when streaming MIDI/VOC/AU/AIFF/M4A over HTTP, and miniz for on-the-fly
# zip download.
# ============================================================================
SRCS_CPP_COMMON := felixwebserver.cpp   sftp_webserver.cpp    \
                   midi_render.cpp      dbopl.cpp             \
                   dbopl_wrapper.cpp    instruments.cpp       \
                   voc_render.cpp       au_render.cpp         \
                   aiff_render.cpp      ssh_session.cpp       \
                   vfs.cpp              term_pty.cpp          \
                   term_pty_win.cpp


SRCS_CPP     := $(SRCS_CPP_COMMON) convertm4atowavlin.cpp
SRCS_CPP_WIN := $(SRCS_CPP_COMMON) convertm4atowavwin.cpp


SRCS_C   := felixchirp/miniz.c felixchirp/miniz_tdef.c \
            felixchirp/miniz_tinfl.c felixchirp/miniz_zip.c

BUILD_DIR       := build/webserver
BUILD_DIR_DEBUG := build/webserver_debug
BUILD_DIR_WIN       := build/webserver_windows
BUILD_DIR_WIN_DEBUG := build/webserver_windows_debug

OBJECTS         := $(addprefix $(BUILD_DIR)/, $(SRCS_CPP:.cpp=.o)) \
                   $(addprefix $(BUILD_DIR)/, $(SRCS_C:.c=.o))
OBJECTS_DEBUG   := $(addprefix $(BUILD_DIR_DEBUG)/, $(SRCS_CPP:.cpp=.debug.o)) \
                   $(addprefix $(BUILD_DIR_DEBUG)/, $(SRCS_C:.c=.debug.o))
OBJECTS_WIN       := $(addprefix $(BUILD_DIR_WIN)/, $(SRCS_CPP_WIN:.cpp=.win.o)) \
                     $(addprefix $(BUILD_DIR_WIN)/, $(SRCS_C:.c=.win.o))
OBJECTS_WIN_DEBUG := $(addprefix $(BUILD_DIR_WIN_DEBUG)/, $(SRCS_CPP_WIN:.cpp=.win.debug.o)) \
                     $(addprefix $(BUILD_DIR_WIN_DEBUG)/, $(SRCS_C:.c=.win.debug.o))

TARGET       := flt_webserver
TARGET_DEBUG := flt_webserver_debug
TARGET_WIN       := flt_webserver.exe
TARGET_WIN_DEBUG := flt_webserver_debug.exe

$(shell mkdir -p $(BUILD_DIR)/felixchirp $(BUILD_DIR_DEBUG)/felixchirp \
                 $(BUILD_DIR_WIN)/felixchirp $(BUILD_DIR_WIN_DEBUG)/felixchirp)

# ============================================================================
# EMBEDDED WEB ASSETS
# sftp_webserver.cpp #includes these generated headers (index.hpp, cookies.hpp,
# etc). Regenerated whenever the underlying web/ files change.
# ============================================================================
WEB_ASSETS := web/404.html web/index.html web/audioDetection.js web/audioVisualizer.js \
              web/cdgPlayer.js web/cookies.js web/fileFilter.js web/imageDetection.js \
              web/karaokePlayer.js web/karaoke-library.js web/panDragHandlers.js \
              web/slideshowAutoplay.js web/theme.js web/videoDetection.js web/videoPlayer.js \
              web/zipReader.js web/zoomPan.js web/crypto-js.min.js

ASSET_HEADERS := 404.hpp index.hpp audioDetection.hpp audioVisualizer.hpp cdgPlayer.hpp \
                 cookies.hpp fileFilter.hpp imageDetection.hpp karaokePlayer.hpp \
                 karaoke-library.hpp panDragHandlers.hpp slideshowAutoplay.hpp theme.hpp \
                 videoDetection.hpp videoPlayer.hpp zipReader.hpp zoomPan.hpp crypto-js.hpp

index.hpp: $(WEB_ASSETS)
	@echo "Generating web asset headers..."
	@rm -f $(ASSET_HEADERS)
	@xxd -i -n 404_html web/404.html > 404.hpp
	@xxd -i -n index_html web/index.html > index.hpp
	@xxd -i -n audioDetection_js web/audioDetection.js > audioDetection.hpp
	@xxd -i -n audioVisualizer_js web/audioVisualizer.js > audioVisualizer.hpp
	@xxd -i -n cdgPlayer_js web/cdgPlayer.js > cdgPlayer.hpp
	@xxd -i -n cookies_js web/cookies.js > cookies.hpp
	@xxd -i -n fileFilter_js web/fileFilter.js > fileFilter.hpp
	@xxd -i -n imageDetection_js web/imageDetection.js > imageDetection.hpp
	@xxd -i -n karaokePlayer_js web/karaokePlayer.js > karaokePlayer.hpp
	@xxd -i -n karaoke_library_js web/karaoke-library.js > karaoke-library.hpp
	@xxd -i -n panDragHandlers_js web/panDragHandlers.js > panDragHandlers.hpp
	@xxd -i -n slideshowAutoplay_js web/slideshowAutoplay.js > slideshowAutoplay.hpp
	@xxd -i -n theme_js web/theme.js > theme.hpp
	@xxd -i -n videoDetection_js web/videoDetection.js > videoDetection.hpp
	@xxd -i -n videoPlayer_js web/videoPlayer.js > videoPlayer.hpp
	@xxd -i -n zipReader_js web/zipReader.js > zipReader.hpp
	@xxd -i -n zoomPan_js web/zoomPan.js > zoomPan.hpp
	@xxd -i -n crypto_js_min_js web/crypto-js.min.js > crypto-js.hpp
	@echo "✓ Converted web assets"

# ============================================================================
# BUILD
# ============================================================================
.PHONY: all debug windows windows-debug clean

all: $(TARGET)

debug: $(TARGET_DEBUG)

windows: $(TARGET_WIN)

windows-debug: $(TARGET_WIN_DEBUG)

$(TARGET): index.hpp $(OBJECTS)
	@echo "Linking: $@"
	$(CXX) $(CXXFLAGS) $(OBJECTS) -o $@ $(LDFLAGS)
	@echo "✓ $@"

$(TARGET_DEBUG): index.hpp $(OBJECTS_DEBUG)
	@echo "Linking (debug, ASan+UBSan): $@"
	$(CXX) $(CXXFLAGS_DEBUG) $(OBJECTS_DEBUG) -o $@ $(LDFLAGS_DEBUG)
	@echo "✓ $@  (run directly, or under gdb, for symbolized ASan traces)"

$(TARGET_WIN): index.hpp $(OBJECTS_WIN)
	@echo "Linking (Windows): $@"
	$(CXX_WIN) $(CXXFLAGS_WIN) $(OBJECTS_WIN) -o $@ $(LDFLAGS_WIN)
	@echo "✓ $@"

$(TARGET_WIN_DEBUG): index.hpp $(OBJECTS_WIN_DEBUG)
	@echo "Linking (Windows debug): $@"
	$(CXX_WIN) $(CXXFLAGS_WIN_DEBUG) $(OBJECTS_WIN_DEBUG) -o $@ $(LDFLAGS_WIN_DEBUG)
	@echo "✓ $@  (run under gdb/x64dbg for stack traces — mingw ASan is unreliable, see note below)"

$(BUILD_DIR)/%.o: %.cpp | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling: $<"
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD_DIR)/%.o: %.c | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling C: $<"
	$(CC) $(CFLAGS_COMMON) -MMD -MP -c $< -o $@

$(BUILD_DIR_DEBUG)/%.debug.o: %.cpp | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling (Debug): $<"
	$(CXX) $(CXXFLAGS_DEBUG) -MMD -MP -c $< -o $@

$(BUILD_DIR_DEBUG)/%.debug.o: %.c | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling C (Debug): $<"
	$(CC) $(CFLAGS_DEBUG) -MMD -MP -c $< -o $@

$(BUILD_DIR_WIN)/%.win.o: %.cpp | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling (Windows): $<"
	$(CXX_WIN) $(CXXFLAGS_WIN) -MMD -MP -c $< -o $@

$(BUILD_DIR_WIN)/%.win.o: %.c | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling C (Windows): $<"
	$(CC_WIN) $(CFLAGS_COMMON) -MMD -MP -c $< -o $@

$(BUILD_DIR_WIN_DEBUG)/%.win.debug.o: %.cpp | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling (Windows Debug): $<"
	$(CXX_WIN) $(CXXFLAGS_WIN_DEBUG) -MMD -MP -c $< -o $@

$(BUILD_DIR_WIN_DEBUG)/%.win.debug.o: %.c | index.hpp
	@mkdir -p $(dir $@)
	@echo "Compiling C (Windows Debug): $<"
	$(CC_WIN) $(CFLAGS_DEBUG) -MMD -MP -c $< -o $@

-include $(OBJECTS:.o=.d)
-include $(OBJECTS_DEBUG:.o=.d)
-include $(OBJECTS_WIN:.o=.d)
-include $(OBJECTS_WIN_DEBUG:.o=.d)

clean:
	rm -rf $(BUILD_DIR) $(BUILD_DIR_DEBUG) $(BUILD_DIR_WIN) $(BUILD_DIR_WIN_DEBUG) \
	       $(TARGET) $(TARGET_DEBUG) $(TARGET_WIN) $(TARGET_WIN_DEBUG) $(ASSET_HEADERS)
